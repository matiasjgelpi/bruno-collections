meta {
  name: 01 POST Auth
  type: http
  seq: 1
}

post {
  url: {{workerBaseUrl}}/auth
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "legajo": "{{legajo}}",
    "documento": "{{documento}}",
    "conversationId": "{{conversationId}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.session_id) {
    bru.setEnvVar("sessionId", res.body.session_id);
  }
}

docs {
  Login contra EDDIS. Crea sesión KV (TTL 8h) y, si se pasa conversationId,
  hace PATCH a la metadata de Laburen guardando session_id.

  Body:
    - legajo (string, requerido)
    - documento (string, requerido)
    - conversationId (string, opcional) — si está, persiste en metadata Laburen

  Response 200: { "session_id": "uuid" }
  Response 400: { "error": "legajo y documento son requeridos" } | body inválido
  Response 401: { "error": "auth_failed" }
  Response 502: { "error": "upstream_error", "detail": "..." }

  El script post-response auto-guarda session_id en el environment.
}
