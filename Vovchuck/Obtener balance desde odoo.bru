meta {
  name: Obtener balance desde odoo
  type: http
  seq: 8
}

post {
  url: {{BASE_URL_PROD}}/jsonrpc
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "call",
    "params": {
      "service": "object",
      "method": "execute_kw",
      "args": [
        "{{BASE_DBNAME_PROD}}",
        14,
        "{{TEST_PASSWORD}}",
        "account.move.line",
        "search_read",
        [
          [
            [
              "partner_id",
              "=",
              7639
            ],
            [
              "account_id.account_type",
              "=",
              "asset_receivable"
            ],
            [
              "parent_state",
              "=",
              "posted"
            ],
            [
              "amount_residual",
              "!=",
              0
            ]
          ]
        ],
        {
          "fields": [
            "id",
            "move_id",
            "move_name",
            "date",
            "date_maturity",
            "name",
            "ref",
            "amount_residual",
            "currency_id",
            "debit",
            "credit"
          ],
          "limit": 200,
          "order": "date asc, id asc"
        }
      ]
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
